{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "muvibe-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "muvibe-web-clear",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081",
        "--clear"
      ],
      "port": 8081
    },
    {
      "name": "blitz-socket-server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/index.js"
      ],
      "port": 3001,
      "url": "http://localhost:3001"
    }
  ]
}
