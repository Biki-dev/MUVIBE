EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Socket.IO server for Blitz Battle private rooms (server/index.js).
# Defaults to http://localhost:3001 when unset, which is fine for the
# web preview. A phone cannot reach the laptop on "localhost", so set
# this to the machine's LAN address when testing on a device, e.g.
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.20:3001
EXPO_PUBLIC_SOCKET_URL=http://localhost:3001
